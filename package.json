    "check:chess-phase": "node scripts/check-chess-phase-browser.mjs",
    "check:motion": "node scripts/check-motion-browser.mjs",
    "check:mobile": "node scripts/check-mobile-screen-browser.mjs",
    "check:kart-motion": "node scripts/check-kart-motion-browser.mjs",
    "check:runner-routes": "node scripts/check-runner-routes-browser.mjs",
    "check:runner-rush": "node scripts/check-runner-rush-browser.mjs",
    "check:runner-stride": "node scripts/check-runner-stride-browser.mjs",
    "check:runner-depth": "node scripts/check-runner-depth-browser.mjs"
